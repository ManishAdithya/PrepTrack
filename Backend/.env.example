# Copy this file to .env.local and fill in your own values (.env.local is git-ignored and overrides .env).
# Optional: Firebase Storage bucket (only used if config/serviceAccountKey.json exists; otherwise files go to Backend/storage)
# FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/preptrack
JWT_SECRET=<a-long-random-string>
PORT=5000
BACKEND_URL=http://localhost:5000

# --- Community rules (all optional; defaults shown) ---
# Only emails from this domain can sign up. Leave empty to allow any email.
ALLOWED_EMAIL_DOMAIN=
# Branches that can sign up, read from the roll number (AM.SC.U4CSE23140 -> CSE). Comma-separated.
ALLOWED_BRANCHES=CSE
# XP needed before a student's uploads are approved instantly
TRUSTED_XP=150
# Upvotes from classmates that approve a pending upload
AUTO_APPROVE_UPVOTES=3
# Reports that hide an upload until a moderator reviews it
AUTO_HIDE_REPORTS=3
